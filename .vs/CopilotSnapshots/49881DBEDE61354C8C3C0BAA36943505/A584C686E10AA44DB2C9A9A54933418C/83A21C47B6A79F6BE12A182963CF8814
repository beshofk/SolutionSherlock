using System.Collections.Generic;
using System.Diagnostics;
using System.Linq;
using Microsoft.Xrm.Sdk;
using Microsoft.Xrm.Sdk.Query;
using Cyberitas.XrmToolBox.SolutionComponentFinder.Models;

namespace Cyberitas.XrmToolBox.SolutionComponentFinder.Helpers
{
    /// <summary>
    /// Shared pagination and ID-batching helpers, used by both SearchEngine (search by
    /// name -> which solutions contain it) and SolutionExplorerService (given a
    /// solution -> resolve its full component list) so the two services don't each
    /// carry their own copy of the same paging loop.
    /// </summary>
    public static class QueryPaging
    {
        /// <summary>Practical ceiling for a QueryExpression "In" condition against Dataverse.</summary>
        public const int BatchSize = 500;

        /// <summary>
        /// Pages through a QueryExpression until MoreRecords is false, returning every
        /// row. Checks for cancellation before every page request - the natural point
        /// to stop, since a page request is the smallest unit of work that can't be
        /// interrupted once issued.
        /// </summary>
        public static List<Entity> RetrieveAllPages(IOrganizationService service, QueryExpression query, SearchProgress progress = null)
        {
            progress = progress ?? SearchProgress.None;

            var results = new List<Entity>();
            var pageNum = 0;
            EntityCollection page;

            do
            {
                progress.ThrowIfCancelled();
                pageNum++;

                var sw = Stopwatch.StartNew();
                page = service.RetrieveMultiple(query);
                results.AddRange(page.Entities);

                // Only log per-page detail when there's genuinely more than one page -
                // the common case is a single page and doesn't need the noise.
                if (pageNum > 1 || page.MoreRecords)
                    progress.Log($"  page {pageNum} of '{query.EntityName}': {page.Entities.Count} row(s) in {sw.ElapsedMilliseconds}ms.");

                if (page.MoreRecords)
                {
                    query.PageInfo.PageNumber++;
                    query.PageInfo.PagingCookie = page.PagingCookie;
                }
            } while (page.MoreRecords);

            return results;
        }

        public static IEnumerable<List<System.Guid>> Chunk(IReadOnlyList<System.Guid> source, int size = BatchSize)
        {
            for (var i = 0; i < source.Count; i += size)
                yield return source.Skip(i).Take(size).ToList();
        }
    }
}
